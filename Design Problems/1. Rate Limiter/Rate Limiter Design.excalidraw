    {
      "id": "e5Jlu0RpMt9J9iIjlyt21",
      "type": "text",
      "x": 1461.9828404017858,
      "y": -295.96664123535163,
      "width": 692.45947265625,
      "height": 75,
      "angle": 0,
      "strokeColor": "#da77f2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
